# Replace this with your own domain, pointing to the relay server.
BRIDGE_DOMAIN=relay.example.com

# Native Android, iOS and desktop origins; this deployment serves no WebUI.
BRIDGE_ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost,bridge://localhost,ionic://localhost,file://,null

BRIDGE_RELAY_IMAGE=bridge-relay:local
BRIDGE_RELAY_MAX_FRAMES_PER_MINUTE=6000
